{
  "name": "change-guard",
  "displayName": "Change Guard",
  "description": "AI-powered code change impact analysis",
  "version": "0.0.3",
  "publisher": "rkshawon",
  "repository": {
    "type": "git",
    "url": "https://github.com/rkshawon/ai-change-impact"
  },
  "license": "MIT",
  "icon": "icon.png",
  "keywords": [
    "git",
    "diff",
    "ai",
    "impact-analysis",
    "code-review",
    "gemini"
  ],
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "change-guard.previewChanges",
        "title": "Change Guard: Preview Changes"
      },
      {
        "command": "change-guard.selectProvider",
        "title": "Change Guard: Select AI Provider (Gemini / OpenAI)"
      },
      {
        "command": "change-guard.setApiKey",
        "title": "Change Guard: Set Custom API Key"
      },
      {
        "command": "change-guard.clearApiKey",
        "title": "Change Guard: Clear Custom API Key (Revert to Default)"
      }
    ],
    "configuration": {
      "title": "Change Guard",
      "properties": {
        "changeGuard.provider": {
          "type": "string",
          "enum": [
            "gemini",
            "openai"
          ],
          "enumDescriptions": [
            "Google Gemini API (Default, Fast, Multimodal)",
            "OpenAI API (GPT-4o, GPT-4o-mini)"
          ],
          "default": "gemini",
          "description": "AI provider used to analyze code changes."
        },
        "changeGuard.geminiModel": {
          "type": "string",
          "default": "gemini-3.6-flash",
          "description": "Google Gemini model to use for analysis."
        },
        "changeGuard.openaiModel": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "OpenAI model to use for analysis."
        },
        "changeGuard.openaiBaseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "Custom API base URL for OpenAI-compatible providers."
        }
      }
    },
    "menus": {
      "scm/title": [
        {
          "command": "change-guard.previewChanges",
          "group": "navigation@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "change-guard.previewChanges",
        "key": "ctrl+alt+g"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "dotenv": "^17.4.2"
  }
}
